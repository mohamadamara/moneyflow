# ================================================================
# Household Money OS — Environment
# ----------------------------------------------------------------
# The app runs WITHOUT these values in "Local Demo" mode
# (data persists in the browser via localStorage).
#
# To switch to the real multi-user SaaS backend:
#   1. Create a project at https://supabase.com
#   2. Run the SQL in  supabase/schema.sql  then  supabase/policies.sql
#      (SQL Editor → paste → Run)
#   3. Fill the values below into  .env.local
#   4. Restart the dev server
# ================================================================

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
